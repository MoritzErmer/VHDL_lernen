// Senso: structure of the hardware (after exercise 2)
digraph senso {
  rankdir=LR; graph [bgcolor="transparent", fontname="Helvetica", fontsize=13, fontcolor="#000001", nodesep=0.35, ranksep=0.55, pad=0];
  node [fontname="Helvetica", fontsize=13, color="#000001", fontcolor="#000001", penwidth=1.3, shape=box];
  edge [fontname="Helvetica", fontsize=11, color="#000002", fontcolor="#000001", penwidth=1.2, arrowsize=0.8];
  tasten [label="4 Taster", style="dashed"];
  input [label="input"];
  control [label="control\n(Automat)", color="#000003", fontcolor="#000003"];
  timer [label="timer"];
  counter [label="counter"];
  random [label="random"];
  output [label="output"];
  leds [label="4 LEDs", style="dashed"];
  anzeige [label="7-Segment\n2 Stellen", style="dashed"];
  tasten -> input [label="key_in_n"];
  input -> control [label="key_valid\nkey_color"];
  control -> timer [label="start, dec,\nres_duration"];
  timer -> control [label="expired"];
  control -> counter [label="res/inc\nstep, score"];
  counter -> control [label="step_eq_score"];
  counter -> anzeige;
  control -> random [label="next, store,\nrestore"];
  random -> control [label="rnd"];
  random -> output [label="color"];
  control -> output [label="led_on\nall_on"];
  output -> leds;
}
