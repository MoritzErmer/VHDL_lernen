// Galois LFSR with fb = "0111001": XOR before q6, q5, q4 and q1, q7 fed back
digraph lfsr {
  rankdir=LR; graph [bgcolor="transparent", fontname="Helvetica", fontsize=13, fontcolor="#000001", nodesep=0.3, ranksep=0.28, pad=0];
  node [fontname="Helvetica", fontsize=13, color="#000001", fontcolor="#000001", penwidth=1.3, shape=box, width=0.45, height=0.4];
  edge [color="#000002", penwidth=1.2, arrowsize=0.7];
  x1 [label="xor", shape=circle, width=0.35, fontsize=10, color="#000003", fontcolor="#000003"];
  x4 [label="xor", shape=circle, width=0.35, fontsize=10, color="#000003", fontcolor="#000003"];
  x5 [label="xor", shape=circle, width=0.35, fontsize=10, color="#000003", fontcolor="#000003"];
  x6 [label="xor", shape=circle, width=0.35, fontsize=10, color="#000003", fontcolor="#000003"];
  q0 -> x1 -> q1 -> q2 -> q3 -> x4 -> q4 -> x5 -> q5 -> x6 -> q6 -> q7;
  q7 -> q0 [constraint=false, label="  q7 zurück", fontname="Helvetica", fontsize=11, fontcolor="#000001"];
}
