// The three automaton structures: where does the output y come from?
digraph strukturen {
  rankdir=LR; newrank=true; graph [bgcolor="transparent", fontname="Helvetica", fontsize=13, fontcolor="#000001", nodesep=0.45, ranksep=0.55, pad=0];
  node [fontname="Helvetica", fontsize=13, color="#000001", fontcolor="#000001", penwidth=1.3];
  edge [fontname="Helvetica", fontsize=12, color="#000002", fontcolor="#000001", penwidth=1.2, arrowsize=0.8];
  node [shape=box, width=0.9, height=0.5];
  subgraph cluster_medw { label="Medwedew: y = Zustand (direkt aus Flipflops)"; color="#000002"; fontcolor="#000001"; style=rounded;
    x3 [label="x", shape=plaintext]; f3 [label="f"]; r3 [label="Register", color="#000003", fontcolor="#000003"]; y3 [label="y", shape=plaintext];
    x3 -> f3; f3 -> r3; r3 -> y3 [color="#000003", penwidth=2]; r3 -> f3 [constraint=false, style=dashed]; }
  subgraph cluster_moore { label="Moore: y = g(Zustand)"; color="#000002"; fontcolor="#000001"; style=rounded;
    x2 [label="x", shape=plaintext]; f2 [label="f"]; r2 [label="Register", color="#000003", fontcolor="#000003"]; g2 [label="g"]; y2 [label="y", shape=plaintext];
    x2 -> f2; f2 -> r2; r2 -> g2; g2 -> y2; r2 -> f2 [constraint=false, style=dashed]; }
  subgraph cluster_mealy { label="Mealy: y = g(x, Zustand)"; color="#000002"; fontcolor="#000001"; style=rounded;
    x1 [label="x", shape=plaintext]; f1 [label="f"]; r1 [label="Register", color="#000003", fontcolor="#000003"]; g1 [label="g"]; y1 [label="y", shape=plaintext];
    x1 -> f1; f1 -> r1; r1 -> g1; g1 -> y1; x1 -> g1 [color="#000003", penwidth=2]; r1 -> f1 [constraint=false, style=dashed]; }
  {rank=same; x1; x2; x3}
}
