// Moore automaton: sequence detector "101" (overlapping), output in the state
digraph moore {
  rankdir=LR; graph [bgcolor="transparent", fontname="Helvetica", fontsize=13, fontcolor="#000001", nodesep=0.45, ranksep=0.55, pad=0];
  node [fontname="Helvetica", fontsize=13, color="#000001", fontcolor="#000001", penwidth=1.3];
  edge [fontname="Helvetica", fontsize=12, color="#000002", fontcolor="#000001", penwidth=1.2, arrowsize=0.8];
  node [shape=circle, width=0.95, fixedsize=true];
  init [shape=point, width=0.08, color="#000002"];
  start [label="start\ny=0"]; s1 [label="s1\ny=0"]; s10 [label="s10\ny=0"];
  s101 [label="s101\ny=1", color="#000003", fontcolor="#000003", penwidth=2.2];
  init -> start [label="res_n"];
  start -> start [label="0"]; start -> s1 [label="1"];
  s1 -> s1 [label="1"]; s1 -> s10 [label="0"];
  s10 -> s101 [label="1"]; s10 -> start [label="0"];
  s101 -> s1 [label="1"]; s101 -> s10 [label="0"];
}
