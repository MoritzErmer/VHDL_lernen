// Delta cycles: every signal stage costs one delta
digraph delta {
  rankdir=LR; graph [bgcolor="transparent", fontname="Helvetica", fontsize=13, fontcolor="#000001", nodesep=0.45, ranksep=0.55, pad=0];
  node [fontname="Helvetica", fontsize=13, color="#000001", fontcolor="#000001", penwidth=1.3];
  edge [fontname="Helvetica", fontsize=12, color="#000002", fontcolor="#000001", penwidth=1.2, arrowsize=0.8];
  node [shape=box, width=0.7, height=0.5];
  a [shape=plaintext]; b [shape=plaintext]; c [shape=plaintext]; p [label="p", shape=plaintext];
  and [label="and"]; or [label="or"];
  a -> and [label="Delta 1"]; b -> and; and -> or [label="pp: Delta 2"]; c -> or; or -> p [label="Delta 3", color="#000003", fontcolor="#000003"];
}
