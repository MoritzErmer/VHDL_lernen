// Conversions with ieee.numeric_std
digraph conv {
  rankdir=LR; graph [bgcolor="transparent", fontname="Helvetica", fontsize=13, fontcolor="#000001", nodesep=0.45, ranksep=0.55, pad=0];
  node [fontname="Helvetica", fontsize=13, color="#000001", fontcolor="#000001", penwidth=1.3];
  edge [fontname="Helvetica", fontsize=12, color="#000002", fontcolor="#000001", penwidth=1.2, arrowsize=0.8];
  node [shape=box, style="rounded", width=1.6, height=0.55, fontname="Courier", fontsize=13];
  slv [label="std_logic_vector"]; u [label="unsigned / signed", color="#000003", fontcolor="#000003", penwidth=2]; i [label="integer"];
  edge [fontname="Courier", fontsize=11];
  slv -> u [label="unsigned(v)"]; u -> slv [label="std_logic_vector(u)"];
  u -> i [label="to_integer(u)"]; i -> u [label="to_unsigned(i, N)"];
}
